# Copy to .env and fill in. See app/config.py for full documentation.

# ---- Azure OpenAI (the only AI provider) ----
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Backend dunning API ----
# Defaults point at the local UAT Docker stack (docker-compose.test.yml in the
# Lummus repo). Start it with: docker compose -f docker-compose.test.yml up -d
BACKEND_API_URL=http://localhost:8001
BACKEND_SERVICE_EMAIL=uat-test@lummus.internal
BACKEND_SERVICE_PASSWORD=UATPassword123!

# ---- Access control ----
ADMIN_UPNS=viraj.yadav@corehelix.ai

# TEMPORARY: only this email domain can log in. Set to empty to remove.
ALLOWED_EMAIL_DOMAIN=corehelix.ai

# Local/offline Outcome Agent demo only — skips Lummus login verify.
# Never enable outside localhost.
DEV_AUTH_BYPASS=false

# ---- Bot Framework / Teams (Phase 4) ----
# App ID + tenant ID are in Lummus's .github/workflows/ci.yml and
# infra/teams-app/manifest.json -- not secret, safe to copy in directly.
# MICROSOFT_APP_PASSWORD (the actual secret) is NOT recoverable from the repo
# -- get it from GitHub repo Settings > Secrets (TEAMS_BOT_APP_SECRET) or the
# Azure AD app registration's Certificates & secrets blade.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=

# ---- Local state ----
STATE_DB_PATH=.state/ar_copilot.db

# ---- UAT data reset (dev-only) ----
# Leave empty to disable the /api/admin/wipe-uat-data endpoint entirely.
UAT_DATABASE_URL=

# ---- Proactive engine (Phase 5 — leave off until then) ----
PROACTIVE_POLL_ENABLED=false
PROACTIVE_POLL_INTERVAL_SECONDS=300

# ---- Document Intelligence (Phase 1B) ----
# SharePoint (Graph API) — ask for a client-credentials app registration with
# Sites.Read.All (or Sites.Selected) on the target site.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_ID=
SHAREPOINT_DOCUMENT_LIBRARY=Documents

# Manual upload — local disk, no external service needed.
DOCUMENTS_LOCAL_DIR=.state/documents

# Azure AI Search (hybrid text+vector index) — not yet provisioned.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=ar-copilot-documents

# Azure AI Document Intelligence (OCR for scanned PDFs) — not yet provisioned.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# ---- Outcome Agent (traced email loop) ----
# live = Azure OpenAI forced tool-calls (needs AZURE_OPENAI_* above)
# mock = ScriptedLLM for offline/demo without tokens
OUTCOME_AGENT_LLM_MODE=live

# ---- Server ----
PORT=8090
LOG_LEVEL=INFO
